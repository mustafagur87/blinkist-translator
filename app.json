{
  "expo": {
    "name": "Blinkist Translator",
    "slug": "blinkist-translator",
    "scheme": "blinkisttranslator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mustafagur.blinkisttranslator"
    },
    "android": {
      "package": "com.mustafagur.blinkisttranslator",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["./plugins/withTextSelectionIntent"]
  }
}
